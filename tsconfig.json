{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "experimentalDecorators": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@ogdakke/fluidbox": ["./packages/fluidbox/src/index.ts"],
      "@ogdakke/fluidbox/elements": ["./packages/fluidbox/src/elements.ts"],
      "@ogdakke/fluidbox/thumbnails": ["./packages/fluidbox/src/thumbnails-entry.ts"],
      "@ogdakke/fluidbox/sheet": ["./packages/fluidbox/src/sheet-entry.ts"],
      "@ogdakke/fluidbox/kit": ["./packages/fluidbox/src/kit.ts"],
      "@ogdakke/fluidbox/hover-zoom": ["./packages/fluidbox/src/hover-zoom.ts"],
      "@ogdakke/fluidbox/embed": ["./packages/fluidbox/src/embed.ts"],
      "@ogdakke/fluidbox/model": ["./packages/fluidbox/src/model.ts"],
      "@ogdakke/fluidbox/spin": ["./packages/fluidbox/src/spin.ts"],
      "@ogdakke/fluidbox/styles.css": ["./packages/fluidbox/src/styles.css.d.ts"],
      "@ogdakke/fluidbox/sheet.css": ["./packages/fluidbox/src/styles.css.d.ts"],
      "@ogdakke/fluidbox/baseline.css": ["./packages/fluidbox/src/styles.css.d.ts"],
      "@ogdakke/fluidbox/react": ["./packages/react/src/index.ts"],
      "@ogdakke/fluidbox/react/embed": ["./packages/react/src/embed.ts"],
      "@ogdakke/fluidbox/react/model": ["./packages/react/src/model.ts"],
      "@ogdakke/fluidbox/react/spin": ["./packages/react/src/spin.ts"],
      "@ogdakke/fluidbox/solid": ["./packages/solid/src/index.ts"],
      "@ogdakke/fluidbox/solid/embed": ["./packages/solid/src/embed.ts"],
      "@ogdakke/fluidbox/solid/model": ["./packages/solid/src/model.ts"],
      "@ogdakke/fluidbox/solid/spin": ["./packages/solid/src/spin.ts"],
      "@ogdakke/fluidbox/vue": ["./packages/vue/src/index.ts"],
      "@ogdakke/fluidbox/vue/embed": ["./packages/vue/src/embed.ts"],
      "@ogdakke/fluidbox/vue/model": ["./packages/vue/src/model.ts"],
      "@ogdakke/fluidbox/vue/spin": ["./packages/vue/src/spin.ts"],
      "@ogdakke/fluidbox/angular": ["./packages/angular/src/index.ts"],
      "@ogdakke/fluidbox/angular/embed": ["./packages/angular/src/embed.ts"],
      "@ogdakke/fluidbox/angular/model": ["./packages/angular/src/model.ts"],
      "@ogdakke/fluidbox/angular/spin": ["./packages/angular/src/spin.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "playwright.config.ts",
    "types.d.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
