{
  "name": "lightbox-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun run --bun vitest run --pool=threads --maxWorkers=1",
    "dev": "vite examples/vanilla",
    "build:example": "bun run --cwd examples/vanilla build",
    "build": "bun run --cwd packages/lightbox build",
    "lint:all": "bun run lint && bun run lint:typecheck",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --type-aware --fix",
    "lint:typecheck": "tsgo --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test:browser": "playwright test",
    "test:browser:visual": "playwright test --grep \"visually stable\" --project=chromium --project=firefox --project=pixel-7",
    "test:browser:baseline": "BASELINE_CAPTURE=1 playwright test tests/browser/baseline.spec.ts --workers=1",
    "inspect:video": "bun run scripts/inspect-video.ts",
    "inspect:failures": "bun run scripts/inspect-failures.ts",
    "dev:share": "bun run --cwd examples/vanilla dev:share"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/react": "^19",
    "@types/bun": "^1.4.2",
    "@angular/common": "^22",
    "@angular/compiler": "^22",
    "@angular/core": "^22",
    "@angular/platform-browser": "^22",
    "@vitejs/plugin-react": "^5",
    "@vitejs/plugin-vue": "^6",
    "@types/react-dom": "^19",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.0",
    "typescript": "^7",
    "react": "^19",
    "react-dom": "^19",
    "rxjs": "^7",
    "solid-js": "^1.9.0",
    "tsdown": "^0.23.0",
    "vite": "^8",
    "vite-plugin-solid": "^2",
    "vue": "^3.5.0",
    "vitest": "^5"
  },
  "packageManager": "bun@1.4.2"
}
