{
  "name": "@ogdakke/fluidbox",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/elements.ts",
    "./src/item.ts",
    "./src/gallery.ts",
    "./src/filmstrip.ts",
    "./src/filmstrip-entry.ts",
    "./src/sheet-entry.ts",
    "./src/styles.css",
    "./src/sheet.css",
    "./src/filmstrip.css",
    "./dist/elements.js",
    "./dist/filmstrip.js",
    "./dist/sheet.js",
    "./dist/styles.css",
    "./dist/sheet.css",
    "./dist/filmstrip.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js"
    },
    "./filmstrip": {
      "types": "./dist/filmstrip.d.ts",
      "import": "./dist/filmstrip.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./hover-zoom": {
      "types": "./dist/hover-zoom.d.ts",
      "import": "./dist/hover-zoom.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./sheet.css": {
      "types": "./dist/sheet.css.d.ts",
      "default": "./dist/sheet.css"
    },
    "./filmstrip.css": {
      "types": "./dist/filmstrip.css.d.ts",
      "default": "./dist/filmstrip.css"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "build:core": "tsdown"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "react": ">=18",
    "react-dom": ">=18",
    "solid-js": ">=1.8",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
