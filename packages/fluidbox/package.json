{
  "name": "@ogdakke/fluidbox",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/elements.ts",
    "./src/item.ts",
    "./src/gallery.ts",
    "./src/filmstrip.ts",
    "./src/styles.css",
    "./src/sheet.css",
    "./dist/elements.js",
    "./dist/styles.css",
    "./dist/sheet.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./filmstrip": {
      "types": "./dist/filmstrip.d.ts",
      "import": "./dist/filmstrip.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./sheet.css": {
      "types": "./dist/sheet.css.d.ts",
      "default": "./dist/sheet.css"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@angular/core": ">=20 <23",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "solid-js": "^1.9.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
